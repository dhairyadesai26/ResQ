# ResQ Web - Environment Configuration

# Server Configuration
RESQ_ENV=development
RESQ_HOST=127.0.0.1
RESQ_PORT=8000
RESQ_LOG_LEVEL=INFO

# Security
RESQ_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESQ_ALLOW_UNRESTRICTED_PATHS=false
RESQ_SUPERVISOR_SECRET=resq-dev-supervisor-token-2026

# Database
DATABASE_URL=sqlite:///./resq.db
SYNC_DATABASE_URL=sqlite:///./resq.db

# Monitoring Engine
RESQ_POLL_INTERVAL_SECONDS=1.0
RESQ_METRICS_INTERVAL_SECONDS=2.0
RESQ_MAX_HISTORY_PER_APP=100

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
