# ==============================================================================
# ResQ Web - Frontend Production / Local Environment Configuration
# ==============================================================================

# Backend API Endpoint (Render Web Service URL)
# For local development: http://127.0.0.1:8000
# For production: https://resq-web-backend.onrender.com (replace with your Render URL)
NEXT_PUBLIC_API_URL="https://resq-web-backend.onrender.com"

# Backend WebSocket Endpoint (Render Web Service WSS URL)
# For local development: ws://127.0.0.1:8000/ws
# For production: wss://resq-web-backend.onrender.com/ws (replace with your Render URL)
NEXT_PUBLIC_WS_URL="wss://resq-web-backend.onrender.com/ws"

